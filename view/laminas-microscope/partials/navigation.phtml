            <?php 
            // Get appropriate collectors based on current page
            $collectorNames = [];
            if (str_contains($currentRoute, '/cache')) {
                $collectorNames = $config->get('laminas_microscope.components.debug_bar.collectors', ['time', 'memory', 'config']);
            } elseif (str_contains($currentRoute, '/analytics')) {
                $collectorNames = $config->get('laminas_microscope.components.microscope.collectors', ['time', 'memory', 'pdo', 'exceptions']);
            } elseif (str_contains($currentRoute, '/performance')) {
                $collectorNames = $config->get('laminas_microscope.components.microscope.collectors', ['time', 'memory', 'pdo']);
            } else {
                // Main dashboard - use microscope collectors
                $collectorNames = $config->get('laminas_microscope.components.microscope.collectors', ['time', 'memory', 'messages']);
            }
            
            // Ensure we have default collectors
            if (empty($collectorNames)) {
                $collectorNames = ['time', 'memory', 'config'];
            }
            ?>
            
            <?php foreach ($collectorNames as $collector): ?>
                <li class="nav-item">
                    <?php if ($isMainDashboard): ?>
                        <button class="nav-link <?= $collector === 'time' ? 'active' : '' ?>" id="tab-<?= $collector ?>" data-bs-toggle="pill" data-bs-target="#pane-<?= $collector ?>" type="button" role="tab">
                            <i class="fas fa-cog"></i> <?= ucfirst($collector) ?>
                        </button>
                    <?php else: ?>
                        <a class="nav-link" href="<?= $this->url('laminas-microscope') ?>#pane-<?= $collector ?>">
                            <i class="fas fa-cog"></i> <?= ucfirst($collector) ?>
                        </a>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
            
            <hr class="my-2">
            <li class="nav-item">
                <a class="nav-link <?= str_contains($currentRoute, '/microscope') ? 'active' : '' ?>" href="<?= $this->url('laminas-microscope/microscope') ?>">
                    <i class="fas fa-microscope"></i> Microscope
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <?= str_contains($currentRoute, '/config') ? 'active' : '' ?>" href="<?= $this->url('laminas-microscope/config') ?>">
                    <i class="fas fa-cogs"></i> Configuration
                </a>
            </li>
        </ul>
    </div>
</nav>