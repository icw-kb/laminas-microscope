<script>
function clearReports() {
    if (confirm('Are you sure you want to clear all analysis reports?')) {
        fetch('<?= $this->url('laminas-microscope/api', ['action' => 'clear-reports']) ?>', {
            method: 'POST'
        }).then(response => {
            if (response.ok) {
                alert('Reports cleared successfully');
                location.reload();
            } else {
                alert('Failed to clear reports');
            }
        });
    }
}

function exportData() {
    window.open('<?= $this->url('laminas-microscope/api', ['action' => 'export']) ?>', '_blank');
}
</script>
