<script>
// Simple performance chart visualization
if (document.getElementById('performanceChart') && <?= json_encode($performance) ?>) {
    const performance = <?= json_encode($performance) ?>;
    const chartContainer = document.getElementById('performanceChart');
    
    // Create a simple bar chart for performance breakdown
    const components = [
        { name: 'Bootstrap', time: performance.bootstrap_time || 0, color: '#007bff' },
        { name: 'Routing', time: performance.routing_time || 0, color: '#28a745' },
        { name: 'Controller', time: performance.controller_time || 0, color: '#ffc107' },
        { name: 'View', time: performance.view_time || 0, color: '#17a2b8' },
        { name: 'Database', time: performance.database_time || 0, color: '#dc3545' }
    ];
    
    const maxTime = Math.max(...components.map(c => c.time));
    
    let chartHtml = '<div class="row">';
    components.forEach(component => {
        const percentage = maxTime > 0 ? (component.time / maxTime) * 100 : 0;
        chartHtml += `
            <div class="col-md-12 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>${component.name}</span>
                    <span class="badge" style="background-color: ${component.color}">${component.time.toFixed(2)}ms</span>
                </div>
                <div class="progress">
                    <div class="progress-bar" style="width: ${percentage}%; background-color: ${component.color}"></div>
                </div>
            </div>
        `;
    });
    chartHtml += '</div>';
    
    chartContainer.innerHTML = chartHtml;
}
</script>
