<script>
// Simple performance chart visualization
// Use the 'breakdown' data provided by the controller
if (document.getElementById('performanceChart') && <?= json_encode($performance['breakdown'] ?? []) ?>) {
    const breakdown = <?= json_encode($performance['breakdown'] ?? []) ?>;
    const chartContainer = document.getElementById('performanceChart');

    // Convert breakdown object to array of objects for charting
    const components = Object.keys(breakdown).map(key => ({
        name: key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()), // Format name (e.g., 'request_start' -> 'Request Start')
        time: breakdown[key] || 0,
        color: getColorForComponent(key) // Helper function for colors
    }));

    // Sort components by time descending
    components.sort((a, b) => b.time - a.time);

    const maxTime = Math.max(...components.map(c => c.time));

    let chartHtml = '<div class="row">';
    components.forEach(component => {
        // Calculate percentage relative to the sum of breakdown times, not max time
        const totalBreakdownTime = components.reduce((sum, c) => sum + c.time, 0);
        const percentage = totalBreakdownTime > 0 ? (component.time / totalBreakdownTime) * 100 : 0;

        chartHtml += `
            <div class="col-md-12 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>${component.name}</span>
                    <span class="badge" style="background-color: ${component.color}">${component.time.toFixed(2)}ms</span>
                </div>
                <div class="progress">
                    <div class="progress-bar" style="width: ${percentage}%; background-color: ${component.color}"></div>
                </div>
            </div>
        `;
    });
    chartHtml += '</div>';

    chartContainer.innerHTML = chartHtml;
}

// Helper function to get consistent colors for components
function getColorForComponent(name) {
    switch (name) {
        case 'bootstrap': return '#007bff'; // Primary (Blue)
        case 'route': return '#28a745'; // Success (Green)
        case 'dispatch': return '#ffc107'; // Warning (Yellow)
        case 'render': return '#17a2b8'; // Info (Cyan)
        case 'database': return '#dc3545'; // Danger (Red)
        case 'request_start': return '#6f42c1'; // Purple
        case 'request_end': return '#6c757d'; // Secondary (Gray)
        default: return '#6c757d'; // Secondary (Gray)
    }
}
</script>
