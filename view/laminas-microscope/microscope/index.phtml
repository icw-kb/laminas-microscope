<script>
function runAnalysis() {
    const button = event.target;
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyzing...';
    button.disabled = true;

    fetch('<?= $this->url('laminas-microscope/api', ['action' => 'run-analysis']) ?>', {
        method: 'POST'
    }).then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Analysis failed: ' + data.message);
        }
    }).finally(() => {
        button.innerHTML = originalText;
        button.disabled = false;
    });
}

function clearReports() {
    if (confirm('Are you sure you want to clear all analysis reports?')) {
        fetch('<?= $this->url('laminas-microscope/api', ['action' => 'clear-reports']) ?>', {
            method: 'POST'
        }).then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert('Failed to clear reports');
            }
        });
    }
}

function deleteReport(reportId) {
    if (confirm('Are you sure you want to delete this report?')) {
        fetch('<?= $this->url('laminas-microscope/api', ['action' => 'delete-report']) ?>', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reportId: reportId })
        }).then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert('Failed to delete report');
            }
        });
    }
}
</script>
