<script>
// Simple chart visualization for query performance
if (document.getElementById('queryChart') && <?= json_encode($queries) ?>.length > 0) {
    const queries = <?= json_encode($queries) ?>;
    const chartData = queries.map((query, index) => ({
        x: index + 1,
        y: query.duration || 0,
        slow: (query.duration || 0) > 100
    }));
    
    // Simple canvas-based chart (you could replace with Chart.js for production)
    const canvas = document.createElement('canvas');
    canvas.width = document.getElementById('queryChart').offsetWidth;
    canvas.height = 200;
    document.getElementById('queryChart').appendChild(canvas);
    
    const ctx = canvas.getContext('2d');
    const maxDuration = Math.max(...chartData.map(d => d.y));
    
    chartData.forEach((point, index) => {
        const x = (index / chartData.length) * canvas.width;
        const y = canvas.height - ((point.y / maxDuration) * (canvas.height - 20));
        
        ctx.fillStyle = point.slow ? '#dc3545' : '#28a745';
        ctx.fillRect(x - 2, y, 4, canvas.height - y);
    });
}
</script>
