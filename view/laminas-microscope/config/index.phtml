<script>
function saveConfiguration() {
    const configData = {
        general: {
            enabled: document.getElementById('enabled').checked,
            environment: document.getElementById('environment').value,
            storage_path: document.getElementById('storagePath').value,
            ip_whitelist: document.getElementById('ipWhitelist').value.split('\n').filter(ip => ip.trim()),
            retention_days: parseInt(document.getElementById('retentionDays').value)
        },
        components: {
            whoops: {
                enabled: document.getElementById('whoopsEnabled').checked,
                editor: document.getElementById('whoopsEditor').value,
                show_in_production: document.getElementById('whoopsShowInProduction').checked
            },
            debug_bar: {
                enabled: document.getElementById('debugBarEnabled').checked,
                position: document.getElementById('debugBarPosition').value,
                collectors: Array.from(document.querySelectorAll('input[name="collectors[]"]:checked')).map(cb => cb.value)
            },
            microscope: {
                enabled: document.getElementById('microscopeEnabled').checked,
                auto_analyze: document.getElementById('microscopeAutoAnalyze').checked,
                thresholds: {
                    query_time: parseInt(document.getElementById('queryThreshold').value)
                },
                checks: {
                    n_plus_one: document.getElementById('check_n_plus_one').checked,
                    slow_queries: document.getElementById('check_slow_queries').checked,
                    duplicate_queries: document.getElementById('check_duplicate_queries').checked
                }
            }
        }
    };

    fetch('<?= $this->url('laminas-microscope/api', ['action' => 'save-config']) ?>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(configData)
    }).then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Configuration saved successfully');
        } else {
            alert('Failed to save configuration: ' + data.message);
        }
    });
}

function exportConfiguration() {
    window.open('<?= $this->url('laminas-microscope/api', ['action' => 'export-config']) ?>', '_blank');
}

function switchEnvironment(environment) {
    fetch('<?= $this->url('laminas-microscope/api', ['action' => 'switch-environment']) ?>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ environment: environment })
    }).then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Failed to switch environment: ' + data.message);
        }
    });
}
</script>
