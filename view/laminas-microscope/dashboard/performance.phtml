<script>
// Initialize charts
document.addEventListener('DOMContentLoaded', function() {
    <?php if (isset($performanceData['analysis']['query_types'])): ?>
        // Query Types Chart
        const queryTypesCtx = document.getElementById('queryTypesChart').getContext('2d');
        const queryTypesData = <?= json_encode($performanceData['analysis']['query_types']) ?>;
        
        new Chart(queryTypesCtx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(queryTypesData),
                datasets: [{
                    data: Object.values(queryTypesData).map(item => item.count),
                    backgroundColor: [
                        '#007bff', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#fd7e14'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    <?php endif; ?>
});

function startRealTimeMonitoring() {
    alert('Real-time monitoring feature coming in Phase 3B!');
}
</script>