<script>
// Initialize charts
document.addEventListener('DOMContentLoaded', function() {
    // Query Performance Chart
    const queryCtx = document.getElementById('queryPerformanceChart').getContext('2d');
    new Chart(queryCtx, {
        type: 'doughnut',
        data: {
            labels: ['Fast Queries', 'Slow Queries', 'Very Slow Queries'],
            datasets: [{
                data: [
                    <?= $analytics['query_analysis']['total_queries'] - count($analytics['query_analysis']['slow_queries']) ?>,
                    <?= count($analytics['query_analysis']['slow_queries']) ?>,
                    <?= count(array_filter($analytics['query_analysis']['slow_queries'], function($q) { return ($q['duration'] ?? 0) > 1000; })) ?>
                ],
                backgroundColor: ['#28a745', '#ffc107', '#dc3545']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });

    // Route Performance Chart
    const routeCtx = document.getElementById('routePerformanceChart').getContext('2d');
    const routeData = <?= json_encode(array_slice($analytics['route_analysis']['popular_routes'], 0, 5)) ?>;
    new Chart(routeCtx, {
        type: 'bar',
        data: {
            labels: Object.keys(routeData),
            datasets: [{
                label: 'Route Hits',
                data: Object.values(routeData),
                backgroundColor: '#007bff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
});

function refreshAnalytics() {
    location.reload();
}

function exportAnalytics() {
    window.open('<?= $this->url('laminas-microscope/api', ['action' => 'export']) ?>', '_blank');
}
</script>