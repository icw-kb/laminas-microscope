// Helper function for formatting bytes
function formatBytes($bytes) {
    if (!is_numeric($bytes)) return '0 B';
    $units = ['B', 'KB', 'MB', 'GB'];
    $unit = 0;
    while ($bytes >= 1024 && $unit < count($units) - 1) {
        $bytes /= 1024;
        $unit++;
    }
    return sprintf('%.2f %s', $bytes, $units[$unit]);
}
