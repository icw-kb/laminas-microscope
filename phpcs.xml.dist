<?xml version="1.0"?>
<ruleset name="LaminasMicroscope">
    <description>Coding standards for Laminas Microscope</description>

    <!-- Include the Laminas Coding Standard (includes PSR-12 + additional rules) -->
    <rule ref="LaminasCodingStandard"/>

    <!-- Show progress -->
    <arg value="p"/>
    
    <!-- Use colors -->
    <arg name="colors"/>

    <!-- Check these files -->
    <file>src</file>
    <file>config</file>
    
    <!-- Exclude vendor directory -->
    <exclude-pattern>vendor</exclude-pattern>
    
    <!-- Exclude view files from some rules -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>view</exclude-pattern>
    </rule>
</ruleset>
